# ---------------------------------------------------------------------------
# Mobile Campus - environment variables TEMPLATE
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Anything named NEXT_PUBLIC_* is visible to the browser. Everything else is
# server-only and must stay secret.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# Local example:  postgresql://postgres:password@localhost:5432/mobile_campus
DATABASE_URL="postgresql://postgres:password@localhost:5432/mobile_campus?schema=public"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mobile Campus"
NEXT_PUBLIC_CAMPUS="Delta State University, Abraka"
# Secret used to sign login session cookies. Make it long and random.
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Secret used to encrypt matric numbers, JAMB numbers and ID numbers at rest.
# Must be at least 32 characters (256 bits) long.
FIELD_ENCRYPTION_KEY="replace-with-another-long-random-string-32-chars"

# --- Flutterwave (payments, escrow releases, transfers) --------------------
FLW_PUBLIC_KEY="FLWPUBK-test-xxxxxxxxxxxxxxxxxxxxxxxx-X"
FLW_SECRET_KEY="FLWSECK-test-xxxxxxxxxxxxxxxxxxxxxxxx-X"
FLW_ENCRYPTION_KEY="FLWSECK-a1b2c3d4e5f6g7h8"
# The hash you set in the Flutterwave dashboard for this webhook endpoint.
FLW_WEBHOOK_HASH="your-flutterwave-webhook-hash"
FLW_WEBHOOK_URL="/api/webhooks/flutterwave"
# Optional: your Flutterwave transfer settlement bank account.
FLW_SETTLEMENT_BANK_CODE="044"
FLW_SETTLEMENT_ACCOUNT="0000000000"
# Test mode keeps real money out of the flow while developing.
FLW_TEST_MODE="true"

# --- Termii (SMS + OTP) ----------------------------------------------------
TERMII_API_KEY="your-termii-api-key"
TERMII_SENDER_ID="MobileCampus"

# --- Cloudinary (image upload + automatic compression) ---------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_UPLOAD_PRESET="mobile-campus-unsigned"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="mobile-campus-unsigned"

# --- Anthropic Claude (AI Budget Assistant - server-side only) -------------
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Seed data -------------------------------------------------------------
# Password used for every demo account created by `npm run db:seed`.
SEED_PASSWORD="password123"
